{
  "name": "prospect-poc",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered B2B prospecting workflow platform (POC)",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @prospect/api prisma:generate",
    "db:migrate": "pnpm --filter @prospect/api prisma:migrate",
    "db:seed": "pnpm --filter @prospect/api prisma:seed",
    "db:validate": "pnpm --filter @prospect/api prisma:validate",
    "dev": "pnpm -r --parallel --filter @prospect/api --filter @prospect/web dev",
    "dev:api": "pnpm --filter @prospect/api dev",
    "dev:web": "pnpm --filter @prospect/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
