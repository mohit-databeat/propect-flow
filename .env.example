# ─────────────────────────────────────────────────────────────
# Prospect Generation POC – environment variables
#
# Setup:  pnpm setup:env            copies this file to .env, generates JWT secrets, and writes
#                                   apps/web/.env.local with NEXT_PUBLIC_API_URL (Next.js does not
#                                   read the monorepo-root .env). Refuses to overwrite existing files.
#         pnpm setup:env --force    overwrites .env and apps/web/.env.local
#   or:   copy .env.example .env and fill JWT_SECRET / JWT_REFRESH_SECRET with 32+ random chars:
#         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#         then create apps/web/.env.local containing NEXT_PUBLIC_API_URL.
#
# Never commit .env or apps/web/.env.local. All provider credentials live here for the POC;
# per-workspace encrypted credential storage is a documented production extension.
# Relative paths are resolved from the monorepo root. All numeric values are validated at startup.
#
# Provider status vocabulary used below:
#   available   = adapter is implemented and selectable (independent of credentials)
#   configured  = required credentials are present in env
#   A stub is available=false even when its key exists → 409 PROVIDER_UNAVAILABLE if selected.
#   An implemented provider without its key → 424 PROVIDER_NOT_CONFIGURED. There is no fallback to mocks.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# docker-compose.yml maps the container's 5432 to host port 5433 (ports: "5433:5432") to avoid clashing
# with a locally installed PostgreSQL on 5432.
DATABASE_URL=postgresql://prospect:prospect@localhost:5433/prospect_poc?schema=public

# ── API (NestJS) ─────────────────────────────────────────────
API_PORT=4000
API_PREFIX=api/v1
WEB_URL=http://localhost:3000                 # CORS origin
LOG_LEVEL=info                                # debug | info | warn | error
SEED_DEMO_DATA=true                           # prisma seed loads demo user/workspace/project/ICP/companies

# ── Auth ─────────────────────────────────────────────────────
# Validation: minimum 32 characters; common placeholders (change-me, secret, example, password, ...) are rejected at startup.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Web (Next.js) ────────────────────────────────────────────
# Mirrored into apps/web/.env.local by `pnpm setup:env`; the value here documents the default.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── AI provider abstraction ──────────────────────────────────
# POC providers (available): mock | anthropic | gemini
# openai remains a documented stub (available=false) and cannot be selected.
# The POC runs fully offline with "mock". Selecting "anthropic"/"gemini" without the matching API key → 424.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional per-purpose model overrides. Leave blank: the selected provider resolves its own defaults
# (fast tier for CSV mapping / qualitative assessment, strong tier for ICP extraction / email / QA).
# Add provider-specific model IDs to your real .env only when needed.
AI_MODEL_ICP_EXTRACTION=
AI_MODEL_CSV_MAPPING_SUGGEST=
AI_MODEL_QUALITATIVE_ASSESS=
AI_MODEL_EMAIL_GENERATE=
AI_MODEL_EMAIL_QA=

# Cost guards (integers)
MAX_LLM_PROSPECTS_PER_RUN=50                  # qualitative assessment cap per workflow run
AI_ASSESS_BATCH_SIZE=10                       # companies per LLM call per criterion
AI_MAX_OUTPUT_TOKENS=2048

# ── Data source connectors ───────────────────────────────────
# Working POC connectors (available): csv, mock_apollo (selected explicitly in the UI; no credentials).
# apollo is a documented stub (available=false) and cannot be selected yet.
# APOLLO_API_KEY is reserved for enabling the real adapter later; setting it only marks apollo as configured.
APOLLO_API_KEY=

# ── Enrichment provider ──────────────────────────────────────
# POC (available): mock_enrichment
# apollo_enrich is a documented stub (available=false) until implemented; APOLLO_API_KEY does not enable it.
ENRICHMENT_PROVIDER=mock_enrichment
ENRICHMENT_CONCURRENCY=3

# ── Outbound provider ────────────────────────────────────────
# POC (available): simulated  (writes .eml files to <DATA_DIR>/outbox)
# smtp is a documented stub (available=false) until a nodemailer adapter is implemented (optional Phase 8).
OUTBOUND_PROVIDER=simulated

# Reserved for the future SMTP adapter; setting these only marks smtp as configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Databeat Sales
SMTP_FROM_EMAIL=

# ── Local data directories (gitignored, resolved from monorepo root) ──
DATA_DIR=./.data                              # uploads -> .data/uploads, simulated outbox -> .data/outbox
MAX_UPLOAD_MB=10
